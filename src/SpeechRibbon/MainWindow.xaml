<Window x:Class="SpeechRibbon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SpeechRibbon" Width="1120" Height="760" MinWidth="940" MinHeight="660"
        Icon="Assets/SpeechRibbon.ico" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource InkBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="Window_Closing" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
          <Image Source="Assets/SpeechRibbon.png" Width="20" Height="20" Stretch="Uniform" Margin="0,0,7,0" />
          <TextBlock Text="SpeechRibbon" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Content="&#xE921;" Style="{StaticResource WindowButtonStyle}" ToolTip="Свернуть" Click="Minimize_Click" />
          <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource WindowButtonStyle}" ToolTip="Развернуть" Click="Maximize_Click" />
          <Button Content="&#xE8BB;" Tag="Close" Style="{StaticResource WindowButtonStyle}" ToolTip="Закрыть" Click="Close_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="24,20,24,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="SpeechRibbon" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,18"/>

      <Border x:Name="FileDropCard" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12"
              AllowDrop="True" DragOver="FileArea_DragOver" Drop="FileArea_Drop">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="39"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Файл" FontWeight="SemiBold" Margin="0,0,0,7"/>
          <TextBox x:Name="FilePathBox" Grid.Row="1" Grid.Column="0" IsReadOnly="True" Height="39" MinHeight="39"
                   Text="Перетащите аудио или видео сюда либо выберите файл" Cursor="Hand" AllowDrop="True" />
          <Button x:Name="ChooseFileButton" Grid.Row="1" Grid.Column="1" Content="Выбрать файл" Click="ChooseFile_Click"
                  Height="39" MinHeight="39" Margin="12,0,0,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="FileInfoText" Grid.Row="2" Grid.ColumnSpan="2" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,7,0,0"/>
        </Grid>
      </Border>

      <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,18,0">
            <TextBlock Text="Результат" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <RadioButton x:Name="TranscribeMode" GroupName="OutputMode" Content="Расшифровать на исходном языке" IsChecked="True"/>
            <RadioButton x:Name="TranslateRussianMode" GroupName="OutputMode" Content="Перевести на русский"/>
            <RadioButton x:Name="TranslateEnglishMode" GroupName="OutputMode" Content="Перевести на английский" Margin="0"/>
          </StackPanel>
          <StackPanel x:Name="TrackPanel" Grid.Column="1" Visibility="Collapsed">
            <TextBlock Text="Аудиодорожка" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <ComboBox x:Name="TrackBox" DisplayMemberPath="Display"/>
            <TextBlock Text="В файле найдено несколько дорожек — выберите нужную" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,7,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="3" Style="{StaticResource CardStyle}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="StatusTitle" Text="Готово к выбору файла" FontWeight="SemiBold" FontSize="16"/>
              <TextBlock x:Name="StatusDetail" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,5,0,0" Text="Обрабатывается только один файл за раз."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="StartButton" Content="Начать" Click="Start_Click" IsEnabled="False" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
              <Button x:Name="CancelButton" Content="Отменить" Click="Cancel_Click" IsEnabled="False"/>
            </StackPanel>
          </Grid>
          <ProgressBar x:Name="WorkProgress" Grid.Row="1" Margin="0,14" Minimum="0" Maximum="100"/>
          <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
              <TextBlock x:Name="ResultHeading" Text="Результат" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CopyButton" Content="Копировать" Click="Copy_Click" IsEnabled="False" Margin="0,0,8,0"/>
                <Button x:Name="SaveButton" Content="Сохранить…" Click="Save_Click" IsEnabled="False"/>
              </StackPanel>
            </DockPanel>
            <Grid Grid.Row="1">
              <DataGrid x:Name="SegmentsGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                        AlternationCount="2" IsReadOnly="False" CellEditEnding="SegmentsGrid_CellEditEnding">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Время" Binding="{Binding TimeLabel}" Width="145" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Говорящий (можно переименовать)" Binding="{Binding Speaker, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                  <DataGridTextColumn Header="Текст" Binding="{Binding DisplayText}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="EmptyResultText" Text="Здесь появятся реплики с временем, говорящими и текстом."
                         Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
          </Grid>
        </Grid>
      </Border>

      <Grid Grid.Row="4" Margin="2,12,0,0">
        <TextBlock Text="© ZombieLite Team" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock Text="Версия " Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
          <TextBlock x:Name="VersionText" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
          <Border Background="{DynamicResource CurrentStatusBrush}" BorderThickness="0" CornerRadius="11" Height="22" Padding="9,0" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Актуальная" Foreground="{DynamicResource CurrentStatusTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </Border>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
