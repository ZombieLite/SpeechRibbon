<Window x:Class="SpeechRibbon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SpeechRibbon" Width="1120" Height="900" MinWidth="940" MinHeight="800"
        Icon="Assets/SpeechRibbon.ico" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource InkBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="Window_Closing" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
  <Window.Resources>
    <Style x:Key="CompactChoiceStyle" TargetType="ComboBox">
      <Setter Property="MinHeight" Value="39"/>
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton x:Name="ChoiceToggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="ChoiceBorder" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <Grid Margin="12,0"><Path HorizontalAlignment="Right" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5"/></Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceBorder" Property="Background" Value="{DynamicResource ChoiceHoverBrush}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource SelectionTextBrush}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,0,34,0" VerticalAlignment="Center"/>
          <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
              <ScrollViewer MaxHeight="240"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="Padding" Value="10,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style></Setter.Value></Setter>
    </Style>
    <Style x:Key="ResultTabStyle" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="TabBorder" Background="Transparent" BorderThickness="0" CornerRadius="7" Padding="12,9">
          <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#D8E7FF"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
          <Image Source="Assets/SpeechRibbon.png" Width="20" Height="20" Stretch="Uniform" Margin="0,0,7,0" />
          <TextBlock Text="SpeechRibbon" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Tag="Minimize" AutomationProperties.Name="Свернуть" Style="{StaticResource WindowButtonStyle}" ToolTip="Свернуть" Click="Minimize_Click" />
          <Button x:Name="MaximizeButton" Tag="Maximize" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}" Style="{StaticResource WindowButtonStyle}" Click="Maximize_Click" />
          <Button AutomationProperties.Name="Закрыть" Tag="Close" Style="{StaticResource WindowButtonStyle}" ToolTip="Закрыть" Click="Close_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="24,20,24,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,18"><TextBlock Text="SpeechRibbon" FontSize="27" FontWeight="SemiBold"/><Button x:Name="SettingsButton" Content="Настройки ИИ" HorizontalAlignment="Right" Click="OpenConnection_Click"/></Grid>

      <Border x:Name="FileDropCard" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12"
              AllowDrop="True" DragOver="FileArea_DragOver" Drop="FileArea_Drop">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="39"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Файл" FontWeight="SemiBold" Margin="0,0,0,7"/>
          <TextBox x:Name="FilePathBox" Grid.Row="1" Grid.Column="0" IsReadOnly="True" Height="39" MinHeight="39"
                   Text="Перетащите аудио или видео сюда либо выберите файл" Cursor="Hand" AllowDrop="True" />
          <Button x:Name="ChooseFileButton" Grid.Row="1" Grid.Column="1" Content="Выбрать файл" Click="ChooseFile_Click"
                  Height="39" MinHeight="39" Margin="12,0,0,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="FileInfoText" Grid.Row="2" Grid.ColumnSpan="2" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,7,0,0"/>
          <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,18,0">
              <TextBlock Text="Результат" FontWeight="SemiBold" Margin="0,0,0,7"/>
              <ComboBox x:Name="OutputModeBox" Width="290" HorizontalAlignment="Left" Style="{StaticResource CompactChoiceStyle}" SelectedIndex="0">
                <ComboBoxItem Content="Расшифровать на исходном языке"/>
                <ComboBoxItem Content="Перевести на русский"/>
                <ComboBoxItem Content="Перевести на английский"/>
              </ComboBox>
            </StackPanel>
            <DockPanel x:Name="TrackPanel" Grid.Column="1" Visibility="Collapsed">
              <TextBlock Text="Аудиодорожка" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <ComboBox x:Name="TrackBox" Style="{StaticResource CompactChoiceStyle}" DisplayMemberPath="Display" ToolTip="В файле найдено несколько дорожек — выбери нужную"/>
            </DockPanel>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Row="3" Style="{StaticResource CardStyle}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="StatusTitle" Text="Готово к выбору файла" FontWeight="SemiBold" FontSize="16"/>
              <TextBlock x:Name="StatusDetail" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,5,0,0" Text="Обрабатывается только один файл за раз."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="StartButton" Content="Начать" Click="Start_Click" IsEnabled="False" Margin="0,0,8,0"/>
              <Button x:Name="CancelButton" Content="Отменить" Click="Cancel_Click" IsEnabled="False"/>
              <Button x:Name="SendPromptButton" Content="Отправить" Click="SendPrompt_Click" Style="{StaticResource PrimaryButtonStyle}" Visibility="Collapsed"/>
              <Button x:Name="CancelAiButton" Content="Отменить" Click="CancelAi_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Grid>
          <ProgressBar x:Name="WorkProgress" Grid.Row="1" Margin="0,14" Minimum="0" Maximum="100"/>
          <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal">
  <RadioButton x:Name="TranscriptTab" GroupName="ResultTab" Style="{StaticResource ResultTabStyle}" Content="Транскрибация" IsChecked="True" Checked="ResultTab_Changed" Margin="0,0,22,0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
  <RadioButton x:Name="AiTab" GroupName="ResultTab" Style="{StaticResource ResultTabStyle}" Content="ИИ" Checked="ResultTab_Changed" Margin="0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
</StackPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CopyButton" Content="Копировать" Click="Copy_Click" IsEnabled="False" Margin="0,0,8,0"/>
                <Button x:Name="SaveButton" Content="Сохранить…" Click="Save_Click" IsEnabled="False"/>
              </StackPanel>
            </DockPanel>
            <Grid x:Name="TranscriptPanel" Grid.Row="1">
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock x:Name="ResultHeading" Grid.Row="1" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>
              <DataGrid x:Name="SegmentsGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                        AlternationCount="2" IsReadOnly="False" CellEditEnding="SegmentsGrid_CellEditEnding">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Время" Binding="{Binding TimeLabel}" Width="145" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Говорящий (можно переименовать)" Binding="{Binding Speaker, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                  <DataGridTextColumn Header="Текст" Binding="{Binding DisplayText}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="EmptyResultText" Text="Здесь появятся реплики с временем, говорящими и текстом."
                         Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <Grid x:Name="AiPanel" Grid.Row="1" Visibility="Collapsed">
              <TextBlock x:Name="AiEmptyText" Text="Сначала получите транскрибацию" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource MutedBrush}"/>
              <Grid x:Name="AiContent" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel x:Name="PromptHeading" Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock Text="Промпт" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                  <Border Width="18" Height="18" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource MutedBrush}" Margin="7,0,0,0" Background="Transparent" Cursor="Help" Focusable="True" AutomationProperties.Name="Что такое промпт" ToolTipService.InitialShowDelay="300" ToolTipService.ShowDuration="30000">
                    <Border.ToolTip>
                      <ToolTip MaxWidth="320" Padding="12,9">
                        <TextBlock Text="Напиши, что ИИ должен сделать с текстом записи. Например: кратко пересказать встречу, выделить решения или составить список задач." TextWrapping="Wrap"/>
                      </ToolTip>
                    </Border.ToolTip>
                    <TextBlock Text="?" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </StackPanel>
                <Grid Grid.Row="1">
                  <Grid.RowDefinitions><RowDefinition x:Name="PromptRow" Height="*"/><RowDefinition x:Name="AnswerRow" Height="0"/></Grid.RowDefinitions>
                  <Grid x:Name="PromptEditor">
                    <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="11,10" VerticalScrollBarVisibility="Auto" TextChanged="Prompt_Changed">
                      <TextBox.Template><ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Stretch"/>
                        </Border>
                      </ControlTemplate></TextBox.Template>
                    </TextBox>
                  </Grid>
                  <Border Grid.Row="1" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="11,10" Visibility="{Binding Visibility, ElementName=AnswerScroller}">
                  <ScrollViewer x:Name="AnswerScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="AnswerPanel" Visibility="Collapsed" Margin="0,0,12,0">
                      <TextBlock x:Name="AnswerLabel" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                      <TextBlock x:Name="AnswerText" TextWrapping="Wrap" FontSize="14" LineHeight="23"/>
                    </StackPanel>
                  </ScrollViewer></Border>
                </Grid>
                <Grid x:Name="AiStatusPanel" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed">
                  <TextBlock x:Name="AiStatusText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                </Grid>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                  <Button x:Name="EditPromptButton" Content="Изменить промпт" Click="EditPrompt_Click" Visibility="Collapsed"/>
                  <Button x:Name="CollapsePromptButton" Content="Вернуться к ответу" Click="CollapsePrompt_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </Border>

      <Grid Grid.Row="4" Margin="2,12,0,0">
        <TextBlock Text="© ZombieLite Team" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock Text="Версия " Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
          <TextBlock x:Name="VersionText" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Grid>
    <Grid x:Name="ConnectionOverlay" Grid.RowSpan="2" Background="#660F172A" Visibility="Collapsed">
      <Border Width="540" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="28">
        <StackPanel>
          <TextBlock Text="Подключение к ИИ" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="Укажи адрес сервера, ключ доступа и модель." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,24"/>
          <TextBlock Text="Base URL" FontWeight="SemiBold" Margin="0,0,0,7"/>
          <TextBox x:Name="ConnectionUrl" Text="" Height="39"/>
          <TextBlock Text="Адрес API твоего сервера" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,18"/>
          <TextBlock Text="API Key" FontWeight="SemiBold" Margin="0,0,0,7"/>
          <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <PasswordBox x:Name="ConnectionKey" PasswordChar="*" Height="39" Padding="11,0" VerticalContentAlignment="Center" Background="Transparent" Foreground="{DynamicResource InkBrush}" CaretBrush="{DynamicResource InkBrush}" SelectionBrush="{DynamicResource SelectionBrush}" BorderThickness="0" FontSize="13"/>
          </Border>
          <TextBlock Text="Ключ скрыт на экране" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,18"/>
          <TextBlock Text="Модель" FontWeight="SemiBold" Margin="0,0,0,7"/>
          <TextBox x:Name="ConnectionModel" Text="" Height="39"/>
          <TextBlock Text="Настройки сохраняются в файле рядом с программой.&#x0a;В этой версии ключ хранится в файле без шифрования." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,18,0,18"/>
          <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <TextBox x:Name="ConnectionStatus" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource MutedBrush}"/>
          </ScrollViewer>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="TestConnectionButton" Content="Проверить подключение" HorizontalAlignment="Left" Click="TestConnection_Click"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Content="Отмена" Click="CloseConnection_Click" Margin="0,0,8,0"/>
              <Button x:Name="SaveConnectionButton" Content="Сохранить" Click="SaveConnection_Click" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>












